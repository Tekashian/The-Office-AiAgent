@startuml Office-AI-Agent-Deployment-Diagram
title The Office AI Agent - Deployment Diagram
skinparam BackgroundColor FFFFFF
skinparam shadowing false

' ============ CLIENT DEVICES ============

node "Client Devices" {
    artifact "Web Browser" as Browser {
        component "Chrome / Firefox / Safari" as BrowserApp
    }
    artifact "Mobile Browser" as MobileBrowser {
        component "iOS / Android Browser" as MobileApp
    }
}

' ============ FRONTEND SERVER ============

node "Frontend Server (Vercel / Custom VPS)" <<execution environment>> {
    package "Next.js 15 Application" {
        component "React 19 UI" as ReactUI
        component "Server Components" as ServerComponents
        component "API Client" as APIClient
        component "Supabase Client SDK" as SupabaseClientSDK
        component "Authentication" as FrontendAuth
        
        artifact "Static Assets" {
            file "CSS (Tailwind)" as CSS
            file "JavaScript Bundles" as JS
            file "Images" as Images
        }
    }
    
    note right of "Next.js 15 Application"
        **Frontend Technology Stack:**
        • Next.js 15 (React Framework)
        • React 19 (UI Library)
        • TypeScript 5
        • Tailwind CSS 4
        • Axios (HTTP Client)
        • Lucide React (Icons)
        • Recharts (Data Visualization)
    end note
}

' ============ BACKEND SERVER ============

node "Backend Server (VPS / Cloud VM)" <<execution environment>> {
    package "Node.js Runtime v20" {
        component "Express Server" as Express {
            port "HTTP :3001" as BackendPort
        }
        
        package "Application Core" {
            component "Controllers Layer" as Controllers {
                component "Base Controller"
                component "Agent Controller"
                component "Dashboard Controller"
            }
            
            component "API Routes Layer" as Routes
            
            component "Services Layer" as Services {
                component "Base Service (Generic CRUD)"
                component "Agent Orchestrator"
                component "AI Service"
                component "User Context Service"
                component "Email Service"
                component "Email Inbox Service"
                component "PDF Service"
                component "Scraper Service"
                component "Cron Service"
            }
            
            component "Middleware Layer" as Middleware {
                component "Request Logger"
                component "Rate Limiter"
                component "Auth Middleware"
                component "Validation"
                component "Error Handler"
                component "CORS Handler"
            }
            
            component "Utilities" as Utils {
                component "Logger (Singleton)"
                component "Cache (LRU + TTL)"
                component "Performance Monitor"
                component "Error Classes"
                component "Encryption/Decryption"
                component "Environment Validation"
            }
            
            component "Configuration" as Config {
                component "Centralized Config (Singleton)"
            }
        }
        
        folder "File Storage" {
            folder "uploads/pdfs" as PDFStorage
            folder "uploads/attachments" as AttachmentStorage
        }
    }
    
    note right of "Node.js Runtime v20"
        **Backend Technology Stack:**
        • Node.js 20 (Runtime)
        • Express 5 (Web Framework)
        • TypeScript 5
        • Nodemailer (Email SMTP)
        • IMAP (Email Fetching)
        • PDFKit (PDF Generation)
        • Cheerio (Web Scraping)
        • Axios (HTTP Client)
        • node-cron (Task Scheduling)
        
        **Phase 2 Optimizations:**
        • Controllers Layer - Request handling
        • BaseService<T> - Generic CRUD
        • Logger Singleton - Structured logging
        • Cache (LRU) - In-memory caching
        • Rate Limiter - Request throttling
        • Config Singleton - Centralized configuration
        • Performance Monitor - Metrics tracking
        • Request Logger - Correlation IDs
        • Error Hierarchy - Custom error classes
    end note
}

' ============ DATABASE ============

database "Supabase Cloud" <<database server>> {
    component "PostgreSQL 15" as Postgres {
        collections "Tables" {
            [user_profiles]
            [user_imap_configs]
            [emails_inbox]
            [ai_email_drafts]
            [emails_sent]
            [email_templates]
            [pdf_templates]
            [pdf_files]
            [scrape_jobs]
            [scrape_history]
            [cron_jobs]
            [chat_messages]
            [notifications]
            [user_context]
        }
    }
    
    component "Auth Service" as SupabaseAuth {
        note right: JWT token generation\nUser management\nRow Level Security
    }
    
    component "Storage Service" as SupabaseStorage {
        folder "Buckets" {
            folder "pdf-files"
            folder "email-attachments"
        }
    }
    
    component "Realtime Service" as SupabaseRealtime {
        note right: WebSocket connections\nReal-time subscriptions
    }
    
    note left of Postgres
        **Database Features:**
        • PostgreSQL 15
        • Row Level Security (RLS)
        • Real-time subscriptions
        • Automatic backups
        • Connection pooling
        • Full-text search
    end note
}

' ============ EXTERNAL SERVICES ============

cloud "External Services" {
    component "Google Gemini AI" as GeminiAPI {
        port "HTTPS" as GeminiPort
        note right: AI Model: gemini-2.5-flash\nAPI: generativelanguage.googleapis.com
    }
    
    component "Gmail SMTP/IMAP" as Gmail {
        port "SMTP :587" as SMTPPort
        port "IMAP :993" as IMAPPort
        note right: Email sending (SMTP)\nInbox scanning (IMAP)\nTLS/SSL encryption
    }
    
    component "Target Websites" as Websites {
        port "HTTPS" as WebPort
        note right: Web scraping targets\nHTML content extraction
    }
}

' ============ MONITORING & LOGGING ============

node "Monitoring (Optional)" <<monitoring>> {
    component "Application Logs" as Logs
    component "Error Tracking\n(Sentry)" as ErrorTracking
    component "Performance\nMonitoring" as PerformanceMonitoring
}

' ============ CONNECTIONS ============

' Client to Frontend
BrowserApp --> ReactUI : HTTPS :443
MobileApp --> ReactUI : HTTPS :443

' Frontend Internal
ReactUI --> ServerComponents : Server-side rendering
ReactUI --> APIClient : API calls
ReactUI --> SupabaseClientSDK : Direct DB access\n(with RLS)

' Frontend to Backend
APIClient --> BackendPort : REST API\nHTTPS/HTTP\nJWT Auth

' Frontend to Supabase
SupabaseClientSDK --> SupabaseAuth : Authentication
SupabaseClientSDK --> Postgres : Queries (with RLS)
SupabaseClientSDK --> SupabaseRealtime : WebSocket

' Backend Internal Flow
Express --> Middleware : Request pipeline
Middleware --> Routes : Authenticated requests
Routes --> Services : Business logic
Services --> Utils : Helper functions
Services --> PDFStorage : File I/O
Services --> AttachmentStorage : File I/O

' Backend to Supabase
Services --> Postgres : SQL Queries\n(Admin client - bypasses RLS)
Services --> SupabaseStorage : File uploads/downloads

' Backend to External Services
Services --> GeminiPort : AI requests\nHTTPS + API Key
Services --> SMTPPort : Send emails\nTLS + SMTP Auth
Services --> IMAPPort : Fetch emails\nSSL + IMAP Auth
Services --> WebPort : Web scraping\nHTTP GET requests

' Monitoring
Express --> Logs : Application logs
Express --> ErrorTracking : Error reporting
Express --> PerformanceMonitoring : Performance metrics

' ============ DEPLOYMENT NOTES ============

note top of "Frontend Server (Vercel / Custom VPS)"
    **Deployment Options:**
    • Vercel (Recommended for Next.js)
    • Netlify
    • AWS Amplify
    • Custom VPS with Nginx
    
    **Environment Variables:**
    • NEXT_PUBLIC_API_URL
    • NEXT_PUBLIC_SUPABASE_URL
    • NEXT_PUBLIC_SUPABASE_ANON_KEY
end note

note top of "Backend Server (VPS / Cloud VM)"
    **Deployment Options:**
    • DigitalOcean Droplet
    • AWS EC2
    • Google Cloud Compute Engine
    • Heroku
    • Railway
    
    **Process Manager:**
    • PM2 (recommended)
    • systemd
    • Docker container
    
    **Reverse Proxy:**
    • Nginx (recommended)
    • Apache
    
    **Environment Variables:**
    • NODE_ENV=production
    • PORT=3001
    • SUPABASE_URL, SUPABASE_ANON_KEY
    • SUPABASE_SERVICE_ROLE_KEY
    • AI_API_KEY, AI_API_URL
    • EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASSWORD
end note

note top of "Supabase Cloud"
    **Managed Service:**
    • Fully managed PostgreSQL
    • Automatic backups
    • SSL/TLS connections
    • Geographic replication
    • 99.9% uptime SLA
    
    **Pricing Tiers:**
    • Free (up to 500MB database)
    • Pro ($25/month)
    • Team ($599/month)
end note

note bottom of "External Services"
    **API Keys Required:**
    • Google AI API key (Gemini)
    • Gmail App Password (if using Gmail)
    
    **Rate Limits:**
    • Gemini: Varies by tier
    • Gmail SMTP: 500 emails/day (free)
    • Gmail IMAP: No strict limit
end note

' ============ SECURITY ============

package "Security Measures" <<frame>> {
    artifact "JWT Authentication" {
        note right: Supabase-issued tokens\nExpiration: 1 hour\nRefresh tokens supported
    }
    
    artifact "Encryption (AES-256)" {
        note right: Passwords encrypted at rest\nDecrypted only in memory
    }
    
    artifact "Row Level Security" {
        note right: Database-level access control\nUser can only see own data
    }
    
    artifact "CORS Configuration" {
        note right: Restrict API access\nto frontend domain only
    }
    
    artifact "Environment Variables" {
        note right: Secrets stored securely\nNever committed to git
    }
}

' ============ SCALABILITY ============

package "Scalability Considerations" <<frame>> {
    note as ScalabilityNote
        **Horizontal Scaling:**
        • Frontend: Deploy multiple instances (CDN + load balancer)
        • Backend: Multiple server instances behind load balancer
        • Database: Read replicas for query optimization
        
        **Caching:**
        • Redis for session storage
        • CDN for static assets (Vercel Edge Network)
        • Database query caching
        
        **Background Jobs:**
        • Cron jobs run on separate worker processes
        • Queue system for heavy tasks (Bull, BullMQ)
        
        **File Storage:**
        • Migrate to S3/GCS for large-scale file storage
        • Use Supabase Storage as primary, S3 as backup
    end note
}

legend right
  |= Symbol |= Meaning |
  | Node | Physical or virtual machine |
  | Component | Software component |
  | Port | Network port |
  | --> | Communication/Dependency |
  
  **Deployment Architecture:**
  • Multi-tier architecture
  • Microservices-ready design
  • Cloud-native approach
  • Scalable and maintainable
  • Production-ready security
endlegend

@enduml

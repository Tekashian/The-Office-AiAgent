@startuml Office-AI-Agent-Use-Case-Diagram
title The Office AI Agent - Use Case Diagram
skinparam BackgroundColor FFFFFF
skinparam shadowing false

left to right direction

' ============ ACTORS ============

actor "Office Worker\n(User)" as User
actor "Administrator" as Admin
actor "System\nScheduler" as Scheduler

' External Systems
actor "Gemini AI" as AI #lightblue
actor "Gmail\nSMTP/IMAP" as Gmail #lightgreen
actor "External\nWebsites" as Websites #lightyellow

' ============ SYSTEM BOUNDARY ============

rectangle "The Office AI Agent System" {
    
    ' ============ AUTHENTICATION ============
    
    package "Authentication & User Management" {
        usecase "Register Account" as UC_Register
        usecase "Login" as UC_Login
        usecase "Manage Profile" as UC_Profile
        usecase "Configure User Context" as UC_Context
        usecase "Set Preferences" as UC_Preferences
    }
    
    ' ============ AI AGENT ============
    
    package "AI Agent Chat" {
        usecase "Chat with AI Agent" as UC_Chat
        usecase "Execute Natural\nLanguage Commands" as UC_Commands
        usecase "Analyze User Intent" as UC_Intent
        usecase "Execute Tools" as UC_Tools
        usecase "View Chat History" as UC_ChatHistory
    }
    
    ' ============ EMAIL MANAGEMENT ============
    
    package "Email Automation" {
        usecase "Configure IMAP/SMTP" as UC_EmailConfig
        usecase "Send Email" as UC_SendEmail
        usecase "Scan Inbox" as UC_ScanInbox
        usecase "AI Email Analysis" as UC_EmailAnalysis
        usecase "Generate Email Draft" as UC_EmailDraft
        usecase "Approve and Send Draft" as UC_SendDraft
        usecase "Manage Email Templates" as UC_EmailTemplates
        usecase "Generate Template\nwith AI" as UC_AIEmailTemplate
        usecase "View Sent Emails" as UC_ViewSent
        usecase "Search Emails" as UC_SearchEmails
    }
    
    ' ============ PDF GENERATION ============
    
    package "PDF Document Generation" {
        usecase "Create PDF Template" as UC_PDFTemplate
        usecase "Generate PDF with AI" as UC_AIPDF
        usecase "Generate PDF\nfrom Template" as UC_TemplatePDF
        usecase "Download PDF" as UC_DownloadPDF
        usecase "View PDF History" as UC_PDFHistory
    }
    
    ' ============ WEB SCRAPING ============
    
    package "Web Scraping & Monitoring" {
        usecase "Create Scrape Job" as UC_CreateScraper
        usecase "Manual Selector\nScraping" as UC_ManualScrape
        usecase "AI-Powered\nScraping" as UC_AIScrape
        usecase "Analyze Page\nStructure" as UC_AnalyzePage
        usecase "Schedule Scraping" as UC_ScheduleScrape
        usecase "Monitor Changes" as UC_MonitorChanges
        usecase "Set Alerts" as UC_SetAlerts
        usecase "View Scrape History" as UC_ScrapeHistory
    }
    
    ' ============ SCHEDULED TASKS ============
    
    package "Task Automation (Cron Jobs)" {
        usecase "Create Cron Job" as UC_CreateCron
        usecase "Schedule Email Task" as UC_CronEmail
        usecase "Schedule PDF Task" as UC_CronPDF
        usecase "Schedule Scraping Task" as UC_CronScrape
        usecase "Enable/Disable Job" as UC_ToggleCron
        usecase "View Job History" as UC_CronHistory
        usecase "Execute Scheduled Task" as UC_ExecuteCron
    }
    
    ' ============ DASHBOARD & MONITORING ============
    
    package "Dashboard & Analytics" {
        usecase "View Dashboard" as UC_Dashboard
        usecase "View Statistics" as UC_Stats
        usecase "View Notifications" as UC_Notifications
        usecase "Search All Data" as UC_GlobalSearch
    }
    
    ' ============ PHASE 2 FEATURES ============
    
    package "Phase 2 Optimizations" #LightCyan {
        usecase "Language-Aware\nResponses" as UC_Language
        usecase "Cached Dashboard\nStatistics" as UC_Cache
        usecase "Rate Limited\nAPI Access" as UC_RateLimit
        usecase "Request Tracing\nwith Correlation IDs" as UC_Tracing
        usecase "Performance\nMonitoring" as UC_Performance
        usecase "Structured\nLogging" as UC_Logging
        usecase "Auto-Schedule\nCron Jobs" as UC_AutoSchedule
    }
}

' ============ USER RELATIONSHIPS ============

User --> UC_Register
User --> UC_Login
User --> UC_Profile
User --> UC_Context
User --> UC_Preferences

User --> UC_Chat
User --> UC_Commands
User --> UC_ChatHistory

User --> UC_EmailConfig
User --> UC_SendEmail
User --> UC_ScanInbox
User --> UC_EmailDraft
User --> UC_SendDraft
User --> UC_EmailTemplates
User --> UC_AIEmailTemplate
User --> UC_ViewSent
User --> UC_SearchEmails

User --> UC_PDFTemplate
User --> UC_AIPDF
User --> UC_TemplatePDF
User --> UC_DownloadPDF
User --> UC_PDFHistory

User --> UC_CreateScraper
User --> UC_ManualScrape
User --> UC_AIScrape
User --> UC_AnalyzePage
User --> UC_ScheduleScrape
User --> UC_MonitorChanges
User --> UC_SetAlerts
User --> UC_ScrapeHistory

User --> UC_CreateCron
User --> UC_CronEmail
User --> UC_CronPDF
User --> UC_CronScrape
User --> UC_ToggleCron
User --> UC_CronHistory

User --> UC_Dashboard
User --> UC_Stats
User --> UC_Notifications
User --> UC_GlobalSearch

User --> UC_Language
User --> UC_Cache
User --> UC_Performance

Admin --> UC_RateLimit
Admin --> UC_Tracing
Admin --> UC_Logging
Admin --> UC_AutoSchedule

' ============ SYSTEM SCHEDULER RELATIONSHIPS ============

Scheduler --> UC_ExecuteCron : triggers
Scheduler --> UC_ScheduleScrape : triggers

' ============ INCLUDE & EXTEND RELATIONSHIPS ============

UC_Chat ..> UC_Intent : <<include>>
UC_Intent ..> UC_Tools : <<include>>

UC_Commands ..> UC_SendEmail : <<extend>>
UC_Commands ..> UC_AIPDF : <<extend>>
UC_Commands ..> UC_AIScrape : <<extend>>
UC_Commands ..> UC_CreateCron : <<extend>>

UC_ScanInbox ..> UC_EmailAnalysis : <<include>>
UC_EmailAnalysis ..> UC_EmailDraft : <<extend>>

UC_SendEmail ..> UC_EmailConfig : <<include>>
UC_SendDraft ..> UC_EmailConfig : <<include>>

UC_AIPDF ..> UC_Context : <<include>>
UC_AIEmailTemplate ..> UC_Context : <<include>>

UC_CreateScraper ..> UC_AnalyzePage : <<extend>>

UC_MonitorChanges ..> UC_SetAlerts : <<extend>>

UC_ExecuteCron ..> UC_SendEmail : <<extend>>
UC_ExecuteCron ..> UC_TemplatePDF : <<extend>>
UC_ExecuteCron ..> UC_AIScrape : <<extend>>

' ============ EXTERNAL SYSTEM RELATIONSHIPS ============

UC_Intent --> AI : requests
UC_EmailAnalysis --> AI : requests
UC_EmailDraft --> AI : requests
UC_AIEmailTemplate --> AI : requests
UC_AIPDF --> AI : requests
UC_AIScrape --> AI : requests
UC_AnalyzePage --> AI : requests

UC_SendEmail --> Gmail : sends via SMTP
UC_SendDraft --> Gmail : sends via SMTP
UC_ScanInbox --> Gmail : fetches via IMAP

UC_ManualScrape --> Websites : HTTP GET
UC_AIScrape --> Websites : HTTP GET
UC_AnalyzePage --> Websites : HTTP GET

' ============ NOTES ============

note right of User
    **Primary User:**
    • Office workers
    • Business professionals
    • Entrepreneurs
    • Anyone needing
      office automation
end note

note top of "AI Agent Chat"
    **Key Feature:**
    Natural language interface
    for all system functions.
    
    User can say:
    "Send email to john@example.com"
    and system executes it.
end note

note top of "Email Automation"
    **Advanced Features:**
    • AI analyzes incoming emails
    • Auto-generates draft responses
    • Categorizes by priority
    • Sentiment analysis
    • Smart templates
end note

note top of "Web Scraping & Monitoring"
    **Two Modes:**
    1. Manual: CSS selectors
    2. AI: Natural language prompts
    
    **Monitoring:**
    • Detect changes
    • Alert notifications
    • Scheduled runs
end note

note top of "Task Automation (Cron Jobs)"
    **Flexible Scheduling:**
    • Daily, weekly, monthly
    • Custom cron expressions
    • Multiple task types
    • Reliable execution
    • Auto-default: 0 9 * * * (daily at 9am)
end note

note top of "Phase 2 Optimizations"
    **Performance & Quality:**
    • Language Detection - Polish/English automatic
    • Cache - LRU with TTL for dashboard stats
    • Rate Limiting - Global + per-route throttling
    • Correlation IDs - Distributed request tracing
    • Performance Metrics - Response time tracking
    • Structured Logging - All operations logged
    • Default Schedules - No frequency input needed
end note

note bottom of Scheduler
    **System Scheduler:**
    node-cron library
    Runs on backend server
    Executes tasks at
    scheduled times
end note

note bottom of AI
    **Gemini AI:**
    • gemini-2.5-flash model
    • Natural language understanding
    • Context-aware responses
    • Template generation
    • Data extraction
end note

note bottom of Gmail
    **Gmail Integration:**
    • SMTP: Send emails
    • IMAP: Read inbox
    • Secure authentication
    • TLS/SSL encryption
end note

' ============ LEGEND ============

legend right
  |= Relationship |= Meaning |
  | --> | User initiates |
  | ..> | Include/Extend |
  | <<include>> | Always executed |
  | <<extend>> | Conditionally executed |
  
  **System Capabilities:**
  • AI-powered automation
  • Email management
  • Document generation
  • Web scraping
  • Task scheduling
  • Multi-user support
  
  **Total Use Cases:** 45+
endlegend

@enduml

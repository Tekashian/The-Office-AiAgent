}

' ============ SERVICE CLASSES ============

package "Controllers Layer" <<Frame>> #E1BEE7 {
    class BaseController <<Controller>> #CE93D8 {
        #success(res: Response, data: any, message?: string, statusCode?: number): void
        #error(res: Response, error: any, statusCode?: number): void
        #created(res: Response, data: any, message?: string): void
        #noContent(res: Response): void
        #getUserId(req: AuthenticatedRequest): string
    }
    
    class AgentController <<Controller>> #CE93D8 {
        +chat: RequestHandler
        +processTask: RequestHandler
        +analyzeText: RequestHandler
    }
    
    class DashboardController <<Controller>> #CE93D8 {
        +getStats: RequestHandler
    }
}

package "Services Layer" <<Database>> #E8F5E9 {
    
    abstract class BaseService <<Service>> #81C784 {
        #tableName: string
        #db: SupabaseClient
        #logger: Logger
        
        +findAll(options?: QueryOptions): Promise<T[]>
        +findById(id: string): Promise<T | null>
        +findByUserId(userId: string, options?: QueryOptions): Promise<T[]>
        +create(data: Partial<T>, userId?: string): Promise<T>
        +update(id: string, data: Partial<T>, userId?: string): Promise<T>
        +delete(id: string, userId?: string): Promise<void>
        #validateData(data: any): void
    }
    
    class AIService <<Service>> #FFFDE7 {
        -apiKey: string
        -apiUrl: string
        -model: string
        
        +sendRequest(request: AIRequest): Promise<AIResponse>
        +processTask(taskDescription: string, context?: any): Promise<string>
        +analyzeText(text: string, analysisType: string): Promise<any>
        +chat(currentMessage: string, conversationHistory?: Array): Promise<string>
        +getUserContext(userId: string): Promise<string>
        +generateEmailTemplate(category: string, additionalContext?: string, userId?: string): Promise<{subject: string, body: string}>
        +generatePDFContent(category: string, additionalContext?: string, userId?: string): Promise<string>
    }
    
    class AgentOrchestrator <<Service>> #FFFDE7 {
        -tools: Tool[]
        
        -getSystemPrompt(): string
        +analyzeIntent(message: string, userId?: string): Promise<AgentAction>
        +executeAction(action: AgentAction, userId?: string): Promise<string>
        -executeSendEmail(params: any, userId?: string): Promise<string>
        -executeGeneratePDF(params: any, userId?: string): Promise<string>
        -executeScrapeWebsite(params: any, userId?: string): Promise<string>
        -executeCreateCronJob(params: any, userId?: string): Promise<string>
        -executeConversation(params: any, userId?: string): Promise<string>
        +processMessage(message: string, userId?: string, conversationHistory?: any[]): Promise<string>
    }
    
    class Tool <<Type>> #E3F2FD {
        +name: string
        +description: string
        +parameters: any
    }
    
    class AgentAction <<Type>> #E3F2FD {
        +tool: string
        +reasoning: string
        +parameters: any
    }
    
    class EmailService <<Service>> #FFFDE7 {
        -transporter: Transporter
        
        +sendEmail(config: EmailConfig): Promise<void>
        +sendBulkEmails(configs: EmailConfig[]): Promise<void>
        +verifyConnection(): Promise<boolean>
    }
    
    class EmailInboxService <<Service>> #FFFDE7 {
        +scanInbox(userId: string): Promise<{success: boolean, emailsFound: number}>
        -fetchUnreadEmails(config: ImapConfig, password: string): Promise<ParsedEmail[]>
        -processEmail(userId: string, email: ParsedEmail): Promise<void>
        -analyzeEmailWithAI(email: ParsedEmail): Promise<EmailAnalysis>
        -generateAIDraft(userId: string, inboxEmailId: string, email: ParsedEmail): Promise<void>
        +generateDraftForEmail(userId: string, email: any): Promise<any>
        +sendApprovedDraft(draftId: string, userId: string): Promise<boolean>
    }
    
    class ImapConfig <<Type>> #E3F2FD {
        +id: string
        +user_id: string
        +imap_host: string
        +imap_port: number
        +imap_user: string
        +imap_password: string
        +use_ssl: boolean
    }
    
    class ParsedEmail <<Type>> #E3F2FD {
        +messageId: string
        +from: {address: string, name?: string}
        +to: string
        +subject: string
        +text: string
        +html: string
        +date: Date

    class ScraperService <<Service>> #FFFDE7 {
        -aiService: AIService
        
        +scrapeWebPage(config: ScrapingConfig): Promise<any>
        +scrapeWithAI(config: {url: string, prompt: string, selectors?: any}): Promise<any>
        +analyzePageStructure(url: string): Promise<any>
        +scrapeMultiplePages(configs: ScrapingConfig[]): Promise<any[]>
        +extractData(html: string, selector: string): string[]

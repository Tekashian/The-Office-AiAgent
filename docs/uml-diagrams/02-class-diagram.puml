' ============ TYPE DEFINITIONS ============

package "Type Definitions" <<Frame>> #E3F2FD {
    enum TaskType <<Type>> #BBDEFB {
        EMAIL
        PDF_GENERATION
        WEB_SCRAPING
        SCHEDULED
        AI_REQUEST
    }
    
    enum TaskStatus <<Type>> #BBDEFB {
        PENDING
        IN_PROGRESS
        COMPLETED
        FAILED
        CANCELLED
    }
    
    enum Priority <<Type>> #BBDEFB {
        LOW
        MEDIUM
        HIGH
        URGENT
    }
    
    class AgentTask <<Type>> #E3F2FD {
        +id: string
        +type: TaskType
        +description: string
        +status: TaskStatus
        +priority: Priority
        +createdAt: Date
        +updatedAt: Date
        +completedAt?: Date
        +result?: any
        +error?: string
    }
    
    class EmailConfig <<Type>> #E3F2FD {
        +to: string | string[]
        +subject: string
        +text?: string
        +html?: string
        +attachments?: EmailAttachment[]
    }
    
    class EmailAttachment <<Type>> #E3F2FD {
        +filename: string

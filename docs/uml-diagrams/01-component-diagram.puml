@startuml Office-AI-Agent-Executive-Expanded
title The Office AI Agent - Complete Architecture (Senior Level - Clean & Detailed)

' ============================================
' EXECUTIVE VIEW - EXPANDED VERSION
' Wszystkie komponenty pokazane czytelnie
' Większy diagram z detalami jak original
' Zachowane senior-level clean layout
' ============================================

!define LIGHTBLUE #E3F2FD
!define LIGHTGREEN #E8F5E9
!define LIGHTPURPLE #F3E5F5
!define LIGHTYELLOW #FFFDE7
!define LIGHTORANGE #FFF3E0

skinparam componentStyle rectangle
skinparam BackgroundColor #FAFAFA
skinparam shadowing false
skinparam RoundCorner 8
skinparam ArrowThickness 2
skinparam Padding 10
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam packageBorderThickness 2
skinparam componentPadding 5
skinparam packagePadding 10

top to bottom direction


' ============================================
' SIMPLIFIED 3-TIER ARCHITECTURE
' ============================================

package "☁️ EXTERNAL APIs" as External LIGHTORANGE {
  [🤖 Gemini AI] as Gemini
  [📧 Gmail API] as Gmail
  [🌐 Web Scraping] as Web
  
  Gemini -[hidden]right-> Gmail
  Gmail -[hidden]right-> Web
}

package "🎨 FRONTEND\n(Next.js 16 + React 19 + TypeScript)" as Frontend LIGHTBLUE {
  
  package "📱 Pages (12)" {
    component "📊 Dashboard" as PageDash
    component "🤖 Agent" as PageAgent
    component "📧 Email" as PageEmail
    component "📬 Inbox" as PageInbox
    component "📄 PDF" as PagePDF
    component "🔎 Scraper" as PageScraper
    component "⏰ Tasks" as PageTasks
    component "🔔 Notif" as PageNotif
    component "⚙️ Settings" as PageSettings
    component "📧 Email Settings" as PageEmailSettings
    component "🔐 Auth" as PageAuth
    component "🏠 Home" as PageHome
    
    note right of PageDash
      **Dashboard Aggregation**
      Pobiera dane z:
      • /dashboard/stats (cron, emails, PDF)
      • /dashboard/recent-tasks
      • /dashboard/activity
      Używa bezpośrednio API Client
      (bez custom hook - prosty fetch)
    end note
    
    PageDash -[hidden]right-> PageAgent
    PageAgent -[hidden]right-> PageEmail
    PageEmail -[hidden]right-> PageInbox
    PageInbox -[hidden]right-> PagePDF
    PagePDF -[hidden]right-> PageScraper
    PageScraper -[hidden]down-> PageTasks
    PageTasks -[hidden]right-> PageNotif
    PageNotif -[hidden]right-> PageSettings
    PageSettings -[hidden]right-> PageEmailSettings
    PageEmailSettings -[hidden]right-> PageAuth
    PageAuth -[hidden]right-> PageHome
  }
  
  package "🪝 Hooks (6)" {
    component "useAgent" as HookAgent
    component "useEmail" as HookEmail
    component "usePDF" as HookPDF
    component "useScraper" as HookScraper
    component "useTasks" as HookTasks
    component "useNotifications" as HookNotif
    
    HookAgent -[hidden]right-> HookEmail
    HookEmail -[hidden]right-> HookPDF
    HookPDF -[hidden]right-> HookScraper
    HookScraper -[hidden]right-> HookTasks
    HookTasks -[hidden]right-> HookNotif
  }
  
  component "🌐 API Client" as APIClient
  component "🗄️ Supabase Client\n(Direct DB Access)" as SupabaseFrontend
  
  APIClient -[hidden]right-> SupabaseFrontend
  
  note right of SupabaseFrontend
    **Frontend Direct DB Access**
    • Real-time subscriptions (WebSocket)
    • Auth state management
    • Bypass backend dla notifications
    • Row Level Security (RLS)
  end note
}

package "🎯 BACKEND\n(Express 5 + Node.js + TypeScript)" as Backend LIGHTPURPLE {
  
  package "🛡️ Middleware (9)" {
    component "Helmet" as Helmet
    component "CORS" as CORS
    component "Logger" as ReqLogger
    component "RateLimit" as RateLimit
    component "Auth" as AuthMW
    component "Validation" as Validation
    component "Upload" as Upload
    component "asyncHandler" as AsyncHandler
    component "ErrorHandler" as ErrorHandler
    
    note right of ErrorHandler
      **Global Error Catcher**
      • Wyłapuje wszystkie błędy z tras
      • Formatuje JSON response
      • Loguje błędy (correlation ID)
      • Ukrywa stack trace (production)
      Działa przez asyncHandler wrapper
    end note
    
    Helmet -[hidden]right-> CORS
    CORS -[hidden]right-> ReqLogger
    ReqLogger -[hidden]right-> RateLimit
    RateLimit -[hidden]down-> AuthMW
    AuthMW -[hidden]right-> Validation
    Validation -[hidden]right-> Upload
    Upload -[hidden]right-> AsyncHandler
  }
  
  package "📍 Routes (13)" {
    component "/agent" as RouteAgent
    component "/ai" as RouteAI
    component "/email" as RouteEmail
    component "/inbox" as RouteInbox
    component "/pdf" as RoutePDF
    component "/scraper" as RouteScraper
    component "/cron" as RouteCron
    component "/dashboard" as RouteDash
    component "/user-ctx" as RouteUserCtx
    component "/notif" as RouteNotif
    component "/search" as RouteSearch
    component "/email-cfg" as RouteEmailConfig
    component "/email-tpl" as RouteEmailTpl
    
    RouteAgent -[hidden]right-> RouteAI
    RouteAI -[hidden]right-> RouteEmail
    RouteEmail -[hidden]right-> RouteInbox
    RouteInbox -[hidden]down-> RoutePDF
    RoutePDF -[hidden]right-> RouteScraper
    RouteScraper -[hidden]right-> RouteCron
    RouteCron -[hidden]right-> RouteDash
    RouteDash -[hidden]down-> RouteUserCtx
    RouteUserCtx -[hidden]right-> RouteNotif
    RouteNotif -[hidden]right-> RouteSearch
    RouteSearch -[hidden]right-> RouteEmailConfig
    RouteEmailConfig -[hidden]right-> RouteEmailTpl
  }
  
  package "🎯 Controllers (2/13)" {
    component "BaseController" as BaseCtrl
    component "AgentController" as AgentCtrl
    component "DashController" as DashCtrl
    
    BaseCtrl -[hidden]right-> AgentCtrl
    AgentCtrl -[hidden]right-> DashCtrl
    
    note right of BaseCtrl
      **Base Controller Pattern**
      • success(res, data)
      • created(res, data)
      • getUserId(req)
      • getPagination(req)
    end note
    
    note right of AgentCtrl
      ⚠️ **TECH DEBT**
      12/13 routes bez controllers:
      • /dashboard (215L inline - DashCtrl UNUSED!)
      • /email (250 lines)
      • /pdf (597 lines)
      • /scraper (499 lines)
      • /cron (inline)
      • /search (180 lines)
      • /notif (250 lines)
      • /user-ctx (280 lines)
      • /email-cfg (150 lines)
      • /email-tpl (350 lines)
      • /inbox (inline)
      • /ai (inline)
      
      EmailService istnieje ale UNUSED -
      AgentOrchestrator ma własną impl (143L).
      
      DashboardController istnieje
      ale dashboardRoutes używa
      inline handlers (215L) zamiast
      delegować do controllera!
    end note
  }
}

package "💎 DOMAIN\n(Business Logic Layer)" as Domain LIGHTGREEN {
  
  package "🤖 Orchestration" {
    component "AgentOrchestrator\n(Mediator)" as Orchestrator
  }
  
  package "⚡ Services (7)" {
    component "AIService" as AIService
    component "EmailService\n⚠️ UNUSED" as EmailService
    component "InboxService" as InboxService
    component "PDFService" as PDFService
    component "ScraperService" as ScraperService
    component "CronService" as CronService
    component "UserContextService\n(extends BaseService)" as UserContextService
    
    AIService -[hidden]right-> EmailService
    EmailService -[hidden]right-> InboxService
    InboxService -[hidden]right-> PDFService
    PDFService -[hidden]down-> ScraperService
    ScraperService -[hidden]right-> CronService
    CronService -[hidden]right-> UserContextService
  }
  
  component "BaseService<T>" as BaseService
  
  note right of Orchestrator
    **Mediator Pattern**
    • analyzeIntent(message, userId)
      → 5 tools: send_email, generate_pdf,
      scrape_website, create_cron_job,
      conversation
    • processMessage() - end-to-end
    • executeAction() - dispatcher
    
    **WŁASNE IMPLEMENTACJE:**
    • executeSendEmail() - 143 lines
      → NODEMAILER directly (nie EmailService!)
      → aiService.generateProfessionalEmail
      → IMAP credentials + user_profiles
      → saves to emails_sent
    • executeCreateCronJob() - 70 lines
      → własna DB + cronService.schedule
    
    **DELEGUJE DO SERWISÓW:**
    • PDFService.generatePDF() ✅
    • ScraperService.scrapeWebPage() ✅
    • AIService (analyzeIntent, chat, enhance) ✅
    
    ⚠️ EmailService istnieje ale UNUSED!
    AgentOrchestrator ma kompletny własny
    stack wysyłki emailów (143 linii kodu).
  end note
}

package "🏗️ INFRASTRUCTURE\n(Technical Layer)" as Infra LIGHTYELLOW {
  
  package "🔧 Utils" {
    component "Logger" as Logger
    component "Cache" as Cache
    component "Config" as Config
    component "Encryption" as Encryption
    
    note right of Logger
      **Używany przez 15+ komponentów**
      Services, Controllers, Routes,
      Middleware, Config
    end note
    
    note right of Cache
      **Używany przez 1 komponent**
      DashboardController.getStats()
      5-min TTL cache
    end note
    
    Logger -[hidden]right-> Cache
    Cache -[hidden]right-> Config
    Config -[hidden]right-> Encryption
  }
  
  component "Supabase Client" as SupabaseBackend
}

database "🗄️ DATABASE\n(PostgreSQL 15 + Supabase)" as DB {
  
  package "👤 User" {
    component "[user_profiles]" as ProfilesTbl
    
    note right of ProfilesTbl
      **Extended with AI Context**
      Kolumny kontekstowe:
      • job_title, work_description
      • company_description, department
      • ai_context_notes, email_signature
      • preferences (JSONB)
      
      Tabela user_context nie istnieje -
      to kolumny w user_profiles!
      (supabase-user-context-migration.sql)
    end note
  }
  
  package "📧 Email" {
    component "[user_email_configs]\n(IMAP + SMTP)" as EmailConfigsTbl
    component "[emails_inbox]" as InboxTbl
    component "[ai_email_drafts]" as DraftsTbl
    component "[email_templates]" as TemplatesTbl
    component "[emails_sent]" as EmailsSentTbl
    component "[email_attachments]" as EmailAttachmentsTbl
    component "[scheduled_emails]" as ScheduledEmailsTbl
    component "[email_scan_logs]" as EmailScanLogsTbl
    
    EmailConfigsTbl -[hidden]right-> InboxTbl
    InboxTbl -[hidden]right-> DraftsTbl
    DraftsTbl -[hidden]right-> TemplatesTbl
    TemplatesTbl -[hidden]down-> EmailsSentTbl
    EmailsSentTbl -[hidden]right-> EmailAttachmentsTbl
    EmailAttachmentsTbl -[hidden]right-> ScheduledEmailsTbl
    ScheduledEmailsTbl -[hidden]down-> EmailScanLogsTbl
  }
  
  package "📄 PDF" {
    component "[pdf_files]" as PDFTbl
    component "[pdf_templates]" as PDFTemplatesTbl
    component "[generated-pdfs]" as GeneratedPDFsTbl
    
    PDFTbl -[hidden]right-> PDFTemplatesTbl
    PDFTemplatesTbl -[hidden]right-> GeneratedPDFsTbl
  }
  
  package "🔎 Scraper" {
    component "[scrape_jobs]" as ScraperJobsTbl
    component "[scrape_history]" as ScraperHistoryTbl
    
    ScraperJobsTbl -[hidden]right-> ScraperHistoryTbl
  }
  
  package "⏰ Cron" {
    component "[cron_jobs]" as CronJobsTbl
    component "[cron_history]" as CronHistoryTbl
    component "[notifications]" as NotificationsTbl
    
    CronJobsTbl -[hidden]right-> CronHistoryTbl
    CronHistoryTbl -[hidden]right-> NotificationsTbl
  }
}



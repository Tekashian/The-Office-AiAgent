    class UserContextService <<Service>> #FFFDE7 {
        -db: SupabaseClient
        -logger: Logger
        
        +formatUserContext(userId: string): Promise<string>
        -getRecentEmails(userId: string, limit: number): Promise<any[]>
        -getRecentTasks(userId: string, limit: number): Promise<any[]>
        -getActiveNotifications(userId: string, limit: number): Promise<any[]>
        -getUserSettings(userId: string): Promise<any>

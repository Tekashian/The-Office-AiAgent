    ' ============================================
    ' APPLICATION LAYER (Controllers - Request Handlers)
    ' ============================================
    package "APPLICATION Controllers (Request/Response Handling)" #E1BEE7 {
        component "🎯 BaseController\n(Abstract Base)" as BaseController #CE93D8
        component "🤖 AgentController\nextends Base" as AgentController #CE93D8
        component "📊 DashboardController\nextends Base" as DashboardController #CE93D8
        
        note right of BaseController
            **⚠️ ARCHITECTURAL DEBT ALERT**
            
            **Current Reality:**
            ✅ **Using Controllers (2/13 routes):**
            • AgentController → /api/agent (3 endpoints)
            • DashboardController → /api/dashboard (partial)
            
            ❌ **NO Controllers (11/13 routes):**
            • EmailRoutes → inline handlers (280 lines)
            • PDFRoutes → inline handlers (597 lines)
            • ScraperRoutes → inline handlers (499 lines)
            • CronRoutes → inline handlers (610 lines)
            • InboxRoutes → inline handlers (439 lines)
            • NotificationRoutes → inline handlers (284 lines)
            • UserContextRoutes → inline handlers (314 lines)
            • EmailConfigRoutes → inline handlers (167 lines)
            • EmailTemplateRoutes → inline handlers (320 lines)
            • SearchRoutes → inline handlers (186 lines)
            • AIRoutes → inline handlers (40 lines)
            
            **Technical Debt:**
            ~3,736 lines of business logic in routers
            
            **Why This Is Bad:**
            1. ❌ Violates Single Responsibility (routes handle HTTP + logic)
            2. ❌ Hard to test (coupled to Express)
            3. ❌ Code duplication (response formatting)
            4. ❌ Inconsistent error handling
            5. ❌ Not true Clean Architecture
            
            **BaseController Pattern (Should Be Used):**
            • success(data, message, code)
            • created(data)
            • noContent()
            • getUserId(req): string
            • getPagination(req)
            
            **Refactoring Priority:**
            🔴 HIGH: EmailRoutes, PDFRoutes (largest files)
            🟡 MEDIUM: ScraperRoutes, CronRoutes
            🟢 LOW: Small routes (AIRoutes, SearchRoutes)
            
            **Estimated Effort:**
            • ~40 hours to refactor all routes
            • ~50% code reduction (DRY via BaseController)
            • +80% test coverage improvement
        end note
    }
    
    ' ============================================
    ' DOMAIN LAYER (Business Logic - Core of the System)
    ' ============================================
    package "DOMAIN Domain/Business Logic Layer (Services)" #E8F5E9 {
        
        ' Core Abstraction
        component "💎 BaseService<T>\n(Generic Repository)" as BaseService #81C784
        
        note right of BaseService
            **Repository Pattern + Generic Programming**
            
            **CRUD Operations:**
            • findById(id): T
            • findAll(options): T[]
            • create(data): T
            • update(id, data): T
            • delete(id): void
            • count(userId): number
            • exists(id): boolean
            
            **Benefits:**
            • DRY - no repeated CRUD code
            • Type-safe with generics
            • Consistent data access
            • Testable (mock Supabase)
            • Follows Single Responsibility
        end note
        
        ' Domain Services (Business Logic)
        component "🤖 AgentOrchestrator\n(Orchestrator)" as AgentOrchestrator #A5D6A7
        component "🧠 AIService\n(Standalone)" as AIService #A5D6A7
        component "📧 EmailService\n(Standalone)" as EmailService #A5D6A7
        component "📬 InboxService\n(Standalone)" as InboxService #A5D6A7

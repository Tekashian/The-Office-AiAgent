
@startuml Office-AI-Agent-Component-Diagram
title The Office AI Agent - Component Diagram
skinparam componentStyle rectangle
skinparam BackgroundColor #FFFFFF
skinparam shadowing false
skinparam RoundCorner 10
skinparam ArrowColor #454545
skinparam defaultTextAlignment center
skinparam packageBorderColor #888888
skinparam packageBackgroundColor #F5F5F5
skinparam componentBorderColor #333333
skinparam componentBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #E0F7FA
skinparam databaseBorderColor #00838F
skinparam cloudBackgroundColor #FFF3E0
skinparam cloudBorderColor #FF9800
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #FBC02D

' Kolory strzałek
skinparam ArrowColor #616161
skinparam ArrowThickness 2

' Ikony emoji dla dziecięcej czytelności
!define FRONTEND_ICON 🖥️
!define BACKEND_ICON 🛠️
!define DB_ICON 🗄️
!define CLOUD_ICON ☁️


' External Systems
cloud "CLOUD_ICON External Services" as ExtCloud #FFECB3 {
    component "🤖 Gemini AI API" as GeminiAPI #FFE0B2
    component "📧 Gmail SMTP/IMAP" as Gmail #FFE0B2
    component "🌐 External Websites" as WebSites #FFE0B2
}


' Frontend Layer
package "FRONTEND_ICON Frontend (Next.js 15)" #E3F2FD {
    package "Page Routes" as Pages #E1F5FE {
        component "💬 Agent Chat Page" as AgentPage #B3E5FC
        component "📥 Email Page" as EmailPage #B3E5FC
        component "📄 PDF Generator Page" as PDFPage #B3E5FC
        component "🔎 Web Scraper Page" as ScraperPage #B3E5FC
        component "⏰ Cron Jobs Page" as CronPage #B3E5FC
        component "📬 Email Inbox Page" as InboxPage #B3E5FC
        component "⚙️ Settings Page" as SettingsPage #B3E5FC
        component "🔔 Notifications Page" as NotifPage #B3E5FC
    }
    
    package "UI Components" as UIComponents #E1F5FE {
        component "🧩 Shared Components" as SharedUI #B3E5FC
        component "🔔 Notification Components" as NotifComponents #B3E5FC
    }
    
    package "Custom Hooks" as Hooks #E1F5FE {
        component "🪝 useNotifications" as useNotifications #B3E5FC
        component "🪝 Other Hooks" as OtherHooks #B3E5FC
    }
    
    component "🔗 API Client (Axios)" as APIClient #90CAF9
    component "🗄️ Supabase Client" as SupabaseFrontend #90CAF9
    component "🔒 Authentication" as AuthFrontend #90CAF9
    component "🔔 Notification Provider" as NotifProvider #90CAF9
}


' Backend Layer
package "BACKEND_ICON Backend (Node.js + Express + TypeScript)" #FFF8E1 {
    component "🚦 Express Server" as ExpressServer #FFE082
    
    package "Middleware Layer" #FFFDE7 {
        component "🛡️ Auth Middleware" as AuthMiddleware #FFD54F
        component "📤 Upload Middleware" as UploadMiddleware #FFD54F
        component "❗ Error Handler" as ErrorHandler #FFD54F
        component "🔍 Request Logger" as RequestLogger #FFD54F
        component "⏱️ Rate Limiter" as RateLimiter #FFD54F
        component "✅ Validation" as ValidationMiddleware #FFD54F
    }
    
    package "API Routes" #FFFDE7 {
        component "🤖 Agent Routes" as AgentRoutes #FFF9C4
        component "🧠 AI Routes" as AIRoutes #FFF9C4
        component "📧 Email Routes" as EmailRoutes #FFF9C4
        component "🔧 Email Config Routes" as EmailConfigRoutes #FFF9C4
        component "📬 Email Inbox Routes" as InboxRoutes #FFF9C4
        component "📑 Email Template Routes" as TemplateRoutes #FFF9C4
        component "📄 PDF Routes" as PDFRoutes #FFF9C4
        component "🔎 Scraper Routes" as ScraperRoutes #FFF9C4
        component "⏰ Cron Routes" as CronRoutes #FFF9C4
        component "📊 Dashboard Routes" as DashboardRoutes #FFF9C4
        component "👤 User Context Routes" as UserContextRoutes #FFF9C4
        component "🔔 Notification Routes" as NotificationRoutes #FFF9C4
        component "🔍 Search Routes" as SearchRoutes #FFF9C4
    }
    
    package "Controllers Layer" #E1BEE7 {
        component "🎮 Base Controller" as BaseController #CE93D8
        component "🤖 Agent Controller" as AgentController #CE93D8
        component "📊 Dashboard Controller" as DashboardController #CE93D8
    }
    
    package "Services Layer" #E8F5E9 {
        component "🎯 Base Service" as BaseService #81C784
        component "🤖 Agent Orchestrator" as AgentOrchestrator #A5D6A7
        component "🧠 AI Service" as AIService #A5D6A7
        component "📧 Email Service" as EmailService #A5D6A7
        component "📬 Email Inbox Service" as InboxService #A5D6A7
        component "📄 PDF Service" as PDFService #A5D6A7
        component "🔎 Scraper Service" as ScraperService #A5D6A7
        component "⏰ Cron Service" as CronService #A5D6A7
        component "👤 User Context Service" as UserContextService #A5D6A7
    }
    
    note right of AgentOrchestrator : Interprets user intent\nExecutes tools\nOrchestrates Cron tasks\nLanguage detection
    note right of AIService : Gemini API integration\nUser context management\nLanguage-aware responses
    note right of InboxService : IMAP inbox scanning\nAI email analysis\nDraft generation
    note right of ScraperService : Web scraping\nAI-powered extraction
    note right of CronService : Node-cron wrapper\nTriggers AgentOrchestrator
    note right of UserContextService : User profile formatting\nAI context generation\nExtends BaseService
    
    package "Utilities" #F3E5F5 {
        component "🔐 Encryption Utils" as Encryption #CE93D8
        component "📁 Init Directories" as InitDirs #CE93D8
        component "🧪 Validate Env" as ValidateEnv #CE93D8
        component "💾 File Storage" as FileStorage #CE93D8
        component "📋 Logger Service" as Logger #CE93D8
        component "🚀 Cache Service" as Cache #CE93D8
        component "❌ Custom Errors" as ErrorClasses #CE93D8
        component "⚡ Performance Utils" as Performance #CE93D8
    }
    
    package "Configuration" #B2DFDB {
        component "⚙️ Centralized Config" as Config #80CBC4
    }
    
    component "🗄️ Supabase Admin Client" as SupabaseBackend #B0BEC5
}


' Database Layer
database "DB_ICON Supabase PostgreSQL" as SupabaseDB #E0F7FA {
    package "Core Tables" #B2EBF2 {
        component "👤 user_profiles" as profiles_tbl #80DEEA
        component "💬 chat_messages" as chat_tbl #80DEEA
    }
    
    package "Email System" #B2EBF2 {
        component "🔑 user_imap_configs" as imap_tbl #80DEEA
        component "🔐 user_email_configs" as smtp_tbl #80DEEA
        component "📥 emails_inbox" as inbox_tbl #80DEEA
        component "📝 ai_email_drafts" as drafts_tbl #80DEEA
        component "📤 emails_sent" as sent_tbl #80DEEA
        component "📑 email_templates" as templates_tbl #80DEEA
    }
    
    package "Document System" #B2EBF2 {
        component "📄 pdf_templates" as pdf_tmpl_tbl #80DEEA
        component "📂 pdf_files" as pdf_tbl #80DEEA
    }
    
    package "Automation" #B2EBF2 {
        component "🕸️ scrape_jobs" as scrape_tbl #80DEEA
        component "📜 scrape_history" as scrape_hist_tbl #80DEEA
        component "⏰ cron_jobs" as cron_tbl #80DEEA
    }
    
    package "User Management" #B2EBF2 {
        component "🧠 user_context" as context_tbl #80DEEA
        component "🔔 notifications" as notif_tbl #80DEEA
    }
}


' ============ CONNECTIONS (UPROSZCZONE I KOLOROWE) ============

' Frontend Architecture (Senior-Level Organization)
Pages -[#1976D2]-> Hooks : Uses
Pages -[#1976D2]-> UIComponents : Renders
NotifPage -[#1976D2,bold]-> useNotifications : State Management
NotifPage -[#1976D2]-> NotifComponents : UI Components
useNotifications -[#1976D2]-> APIClient : API Calls
NotifComponents -[#1976D2]-> SharedUI : Shared UI

' Frontend to Backend
APIClient -[#1976D2,bold]-> ExpressServer : HTTP/REST
UIComponents -[#43A047]-> SupabaseFrontend : Direct DB
Pages -[#1976D2]-> AuthFrontend : Auth
NotifProvider -[#43A047]-> SupabaseFrontend : Subscribe

' Backend Flow (Middleware Chain)
ExpressServer -[#FBC02D,bold]-> RequestLogger : Log
RequestLogger -[#FBC02D]-> RateLimiter : Limit
RateLimiter -[#FBC02D]-> AuthMiddleware : Auth
AuthMiddleware -[#FBC02D]-> AgentRoutes
AuthMiddleware -[#FBC02D]-> AIRoutes
AuthMiddleware -[#FBC02D]-> EmailRoutes
AuthMiddleware -[#FBC02D]-> EmailConfigRoutes
AuthMiddleware -[#FBC02D]-> InboxRoutes
AuthMiddleware -[#FBC02D]-> TemplateRoutes
ExpressServer -[#FBC02D]-> UploadMiddleware : Files
AuthMiddleware -[#FBC02D]-> PDFRoutes
AuthMiddleware -[#FBC02D]-> ScraperRoutes
AuthMiddleware -[#FBC02D]-> CronRoutes
AuthMiddleware -[#FBC02D]-> DashboardRoutes
AuthMiddleware -[#FBC02D]-> UserContextRoutes
AuthMiddleware -[#FBC02D]-> NotificationRoutes
AuthMiddleware -[#FBC02D]-> SearchRoutes

' Routes to Controllers
AgentRoutes -[#8E24AA,bold]-> AgentController : Delegate
DashboardRoutes -[#8E24AA,bold]-> DashboardController : Delegate

' Controllers to Services
AgentController -[#388E3C,bold]-> AgentOrchestrator : Process
DashboardController -[#388E3C]-> Cache : Check
DashboardController -[#388E3C]-> SupabaseBackend : Query

' Routes to Services (direct - legacy routes)
AIRoutes -[#388E3C]-> AIService : AI
EmailRoutes -[#388E3C]-> EmailService : Email
EmailConfigRoutes -[#388E3C]-> SupabaseBackend : Config
InboxRoutes -[#388E3C]-> InboxService : Inbox
TemplateRoutes -[#388E3C]-> AIService : Template
PDFRoutes -[#388E3C,dashed]-> PDFService : PDF (async)
PDFRoutes -[#388E3C]-> AIService : AI
ScraperRoutes -[#388E3C,dashed]-> ScraperService : Scrape (async)
CronRoutes -[#388E3C]-> CronService : Jobs

' Agent Orchestrator Orchestration
AgentOrchestrator -[#8E24AA,bold]-> AIService : Intent
AgentOrchestrator -[#8E24AA]-> EmailService : Email
AgentOrchestrator -[#8E24AA]-> PDFService : PDF
AgentOrchestrator -[#8E24AA]-> ScraperService : Scrape

' Cron Service Flow (CORRECTED)
CronService -[#8E24AA,dashed,bold]-> AgentOrchestrator : Trigger⏰\n(async)

' Services to External & Database
AIService -[#FF9800,bold]-> GeminiAPI : API
AIService -[#00838F]-> UserContextService : Context
UserContextService -[#00838F]-> SupabaseBackend : Profile
EmailService -[#FF9800]-> Gmail : SMTP
InboxService -[#FF9800,dashed]-> Gmail : IMAP (async)
InboxService -[#00838F]-> AIService : Analyze
ScraperService -[#FF9800]-> WebSites : HTTP
ScraperService -[#00838F]-> AIService : Extract

' All Services to Database (grupowanie)
AgentOrchestrator -[#00838F,bold]-> SupabaseBackend
EmailService -[#00838F]-> SupabaseBackend
InboxService -[#00838F]-> SupabaseBackend
PDFService -[#00838F]-> SupabaseBackend
ScraperService -[#00838F]-> SupabaseBackend
CronService -[#00838F]-> SupabaseBackend

' Services use utilities
AgentOrchestrator -[#CE93D8]-> Logger : Log
AIService -[#CE93D8]-> Logger : Log
AIService -[#CE93D8]-> Config : Settings
EmailService -[#CE93D8]-> Logger : Log
InboxService -[#CE93D8]-> Logger : Log
UserContextService -[#CE93D8]-> Logger : Log
DashboardController -[#CE93D8]-> Cache : Cache
BaseController -[#CE93D8]-> ErrorClasses : Errors

' Database Layer
SupabaseBackend -[#0288D1,bold]-> profiles_tbl
SupabaseBackend -[#0288D1]-> chat_tbl
SupabaseBackend -[#0288D1]-> imap_tbl
SupabaseBackend -[#0288D1]-> smtp_tbl
SupabaseBackend -[#0288D1]-> inbox_tbl
SupabaseBackend -[#0288D1]-> drafts_tbl
SupabaseBackend -[#0288D1]-> sent_tbl
SupabaseBackend -[#0288D1]-> templates_tbl
SupabaseBackend -[#0288D1]-> pdf_tmpl_tbl
SupabaseBackend -[#0288D1]-> pdf_tbl
SupabaseBackend -[#0288D1]-> scrape_tbl
SupabaseBackend -[#0288D1]-> cron_tbl
SupabaseBackend -[#0288D1]-> notif_tbl

' Utilities
EmailService -[#CE93D8]-> Encryption : Decrypt
InboxService -[#CE93D8]-> Encryption : Decrypt
ExpressServer -[#CE93D8]-> InitDirs : Init
ExpressServer -[#CE93D8]-> ValidateEnv : Config
UploadMiddleware -[#CE93D8]-> FileStorage : Store
PDFService -[#CE93D8]-> FileStorage : Save

' Error Handling
ExpressServer -[#D32F2F,bold]-> ErrorHandler : Errors


legend right
    |= Symbol / Line |= Meaning |
    | 🖥️ | Frontend (Next.js, React) |
    | 🛠️ | Backend (Node.js, Express) |
    | 🗄️ | Database (Supabase/PostgreSQL) |
    | ☁️ | External Service (AI, Gmail, Web) |
    | 🪝 | Custom React Hooks (Business Logic) |
    | 🎮 | Controllers (Request handling layer) |
    | 🎯 | Base Classes (Inheritance hierarchy) |
    | Package | Logical grouping |
    | --> | Dependency/Call direction |
    | <color:#1976D2><b>niebieska gruba</b></color> | Frontend → Backend/API komunikacja |
    | <color:#43A047>zielona</color> | Frontend → Supabase (bezpośredni dostęp) |
    | <color:#FBC02D><b>żółta gruba</b></color> | Backend: middleware chain (logging, auth, rate limiting) |
    | <color:#8E24AA><b>fioletowa gruba</b></color> | Routes → Controllers (new architecture) |
    | <color:#388E3C><b>ciemnozielona gruba</b></color> | Controllers/Routes → Services (business logic) |
    | <color:#FF9800><b>pomarańczowa gruba</b></color> | Połączenia z zewnętrznymi systemami |
    | <color:#00838F><b>turkusowa gruba</b></color> | Połączenia z bazą danych |
    | <color:#0288D1><b>niebieska jasna</b></color> | Backend → tabele bazy danych |
    | <color:#CE93D8>fioletowa jasna</color> | Services → Utilities (logger, cache, config) |
    | <color:#D32F2F><b>czerwona gruba</b></color> | Obsługa błędów |
    | ---> (dashed) | Asynchroniczne operacje (queue-based/long-running) |
  
    **Key Features:**
    • AI-powered office automation with language detection
    • Dual email system (IMAP receiving + SMTP sending)
    • PDF generation with templates + file storage
    • Web scraping with AI extraction (async)
    • Scheduled tasks via Agent Orchestrator
    • Real-time notifications with Supabase
    • Multi-user support with RLS
    • **Senior-level Architecture:**
      - Controller layer for request handling
      - BaseController/BaseService patterns
      - Structured logging with Logger service
      - In-memory caching with Cache service
      - Request tracing with correlation IDs
      - Rate limiting (global + per-route)
      - Centralized configuration management
      - Custom error hierarchy
      - Performance monitoring
endlegend

@enduml

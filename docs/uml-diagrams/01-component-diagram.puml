@startuml Office-AI-Agent-Executive-Expanded
title The Office AI Agent - Complete Architecture (Senior Level - Clean & Detailed)

' ============================================
' EXECUTIVE VIEW - EXPANDED VERSION
' Wszystkie komponenty pokazane czytelnie
' Większy diagram z detalami jak original
' Zachowane senior-level clean layout
' ============================================

!define LIGHTBLUE #E3F2FD
!define LIGHTGREEN #E8F5E9
!define LIGHTPURPLE #F3E5F5
!define LIGHTYELLOW #FFFDE7
!define LIGHTORANGE #FFF3E0

skinparam componentStyle rectangle
skinparam BackgroundColor #FAFAFA
skinparam shadowing false
skinparam RoundCorner 10
skinparam ArrowThickness 2
skinparam Padding 20
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
skinparam packageBorderThickness 2

left to right direction


' ============================================
' SIMPLIFIED 3-TIER ARCHITECTURE
' ============================================

package "☁️ EXTERNAL APIs" as External LIGHTORANGE {
  [🤖 Gemini AI] as Gemini
  [📧 Gmail API] as Gmail
  [🌐 Web Scraping] as Web
}

package "🎨 FRONTEND - Presentation Layer\n(Next.js 14 + React + TypeScript)" as Frontend LIGHTBLUE {
  
  package "📱 Pages (11 total)" as FrontendPages {
    component "📊 Dashboard" as PageDash
    component "🤖 Agent Chat" as PageAgent
    component "📧 Email" as PageEmail
    component "📬 Email Inbox" as PageInbox
    component "📄 PDF" as PagePDF
    component "🔎 Scraper" as PageScraper
    component "⏰ Tasks/Cron" as PageTasks
    component "🔔 Notifications" as PageNotif
    component "⚙️ Settings" as PageSettings
    component "🔐 Auth" as PageAuth
    component "🏠 Home" as PageHome
  }
  
  package "🪝 Custom Hooks (6 total)" as FrontendHooks {
    component "useAgent" as HookAgent
    component "useEmail" as HookEmail
    component "usePDF" as HookPDF
    component "useScraper" as HookScraper
    component "useTasks" as HookTasks
    component "useNotifications" as HookNotif
  }
  
  package "🧩 UI Components" as UIComponents {
    component "Design System\n(shadcn/ui)" as DesignSystem
    component "Notification\nComponents" as NotifUI
  }
  
  package "🔄 Context Providers" as Contexts {
    component "NotificationProvider" as NotifProvider
    component "PDFRefreshProvider" as PDFProvider
  }
  
  component "🌐 API Client\n(Axios + Interceptors)" as APIClient
  component "🗄️ Supabase Client\n(Direct DB)" as SupabaseFrontend
}

package "🎯 BACKEND - Application Layer\n(Express + Node.js + TypeScript)" as Backend LIGHTPURPLE {
  
  package "🛡️ Middleware Pipeline" as Middleware {
    component "1️⃣ Helmet (Security)" as Helmet
    component "2️⃣ CORS" as CORS
    component "3️⃣ Request Logger" as ReqLogger
    component "4️⃣ Rate Limiter" as RateLimit
    component "5️⃣ Auth (JWT)" as AuthMW
    component "6️⃣ Validation (Zod)" as Validation
    component "7️⃣ Upload (Multer)" as Upload
    component "⚡ asyncHandler" as AsyncHandler
    component "9️⃣ Error Handler" as ErrorHandler
    
    note right of Helmet
      **Helmet - Security Headers**
      Dodaje 13 nagłówków bezpieczeństwa:
      • X-Content-Type-Options: nosniff
      • X-Frame-Options: DENY
      • Strict-Transport-Security
      • X-XSS-Protection
      Chroni przed: XSS, Clickjacking, MIME sniffing
    end note
    
    note right of CORS
      **CORS - Cross-Origin Resource Sharing**
      Kontroluje dostęp między domenami:
      • Zezwala: localhost:3000 → localhost:3001
      • Blokuje: inne domeny
      • Headers: Access-Control-Allow-Origin
      Zabezpiecza przed nieautoryzowanymi requestami
    end note
    
    note left of ErrorHandler
      **Global Error Handler**
      Ostatni middleware w pipeline
      Łapie wszystkie błędy z:
      • Routes (404, 500)
      • Controllers (Business logic errors)
      • Services (External API errors)
      • Validation (400 Bad Request)
      Zwraca: Formatted JSON error response
    end note
  }
  
  package "📍 REST Routes (13 total)" as Routes {
    component "/api/agent" as RouteAgent
    component "/api/ai" as RouteAI
    component "/api/email" as RouteEmail
    component "/api/email-inbox" as RouteInbox
    component "/api/email-config" as RouteEmailConfig
    component "/api/email-templates" as RouteEmailTpl
    component "/api/pdf" as RoutePDF
    component "/api/scraper" as RouteScraper
    component "/api/cron" as RouteCron
    component "/api/dashboard" as RouteDash
    component "/api/user-context" as RouteUserCtx
    component "/api/notifications" as RouteNotif
    component "/api/search" as RouteSearch
  }
  
  package "🎯 Controllers (2/13)" as Controllers {
    component "BaseController\n(Abstract)" as BaseCtrl
    component "AgentController\nextends Base" as AgentCtrl
    component "DashboardController\nextends Base" as DashCtrl
    
    note right of AgentCtrl
      ⚠️ **ARCHITECTURAL DEBT**
      Only 2/13 routes use controllers
      11 routes have inline handlers (~3,736 lines)
      
      Priority Refactoring:
      🔴 EmailController (280 lines)
      🔴 PDFController (597 lines)
      🟡 ScraperController (499 lines)
    end note
  }
}

package "💎 DOMAIN - Business Logic Layer\n(Pure Business Rules)" as Domain LIGHTGREEN {
  
  component "💎 BaseService<T>\n(Generic Repository)" as BaseService
  
  note right of BaseService
    **Repository Pattern (SOLID)**
    • Generyczne CRUD operacje
    • Type-safe: BaseService<T>
    • DI friendly (constructor injection)
    
    **ONLY 1/7 services extends Base:**
    ✅ UserContextService
    ❌ 6 innych - Standalone
    
    **Powód:** Specjalizowane wzorce
    (API Client, SMTP, IMAP, File Storage)
  end note
  
  package "🤖 Orchestration" as Orchestration {
    component "AgentOrchestrator\n(Mediator Pattern)" as Orchestrator
    
    note left of Orchestrator
      **Design Pattern: Mediator**
      • Koordynuje 5 services
      • Reduces coupling
      • Single point of orchestration
      
      **Coordinates:**
      AI + Email + PDF + Scraper + Cron
    end note
  }
  
  package "⚡ Core Services (7 total)" as CoreServices {
    component "🧠 AIService\n(Standalone)" as AIService
    component "📧 EmailService\n(Standalone)" as EmailService
    component "📬 InboxService\n(Standalone)" as InboxService
    component "📄 PDFService\n(Standalone)" as PDFService
    component "🔎 ScraperService\n(Standalone)" as ScraperService
    component "⏰ CronService\n(Standalone)" as CronService
    component "👤 UserContextService\n✅ extends BaseService" as UserContextService
  }
}

package "🏗️ INFRASTRUCTURE - Technical Layer\n(Cross-Cutting Concerns)" as Infra LIGHTYELLOW {
  
  package "🔧 Utilities" as Utils {
    component "📋 Logger\n(Winston Singleton)" as Logger
    component "🚀 Cache\n(In-Memory LRU)" as Cache
    component "🔧 Config\n(Type-Safe Singleton)" as Config
    component "🔐 Encryption\n(AES-256-GCM)" as Encryption
    component "❌ Error Classes\n(AppError Hierarchy)" as ErrorClasses
    component "⚡ Performance Monitor" as Performance
    component "💾 File Storage\n(Local + Cleanup)" as FileStorage
  }
  
  package "🗄️ Data Access" as DataAccess {
    component "Supabase Admin Client\n(PostgreSQL SDK)" as SupabaseBackend
    
    note right of SupabaseBackend
      **Database Client:**
      • PostgreSQL 15 (Supabase)
      • Connection pooling
      • Admin privileges
      • Type-safe queries
    end note
  }
}

database "🗄️ DATABASE - PostgreSQL 15\n(Supabase Cloud + Row Level Security)" as DB {
  
  package "👤 User & Auth" as UserTables {
    component "[user_profiles]" as ProfilesTbl
    component "[user_context]" as ContextTbl
  }
  
  package "📧 Email Domain" as EmailTables {
    component "[user_imap_configs]" as IMAPTbl
    component "[user_smtp_configs]" as SMTPTbl
    component "[emails_inbox]" as InboxTbl
    component "[email_drafts]" as DraftsTbl
    component "[email_templates]" as TemplatesTbl
  }
  
  package "📄 PDF & Files" as PDFTables {
    component "[pdf_files]" as PDFTbl
    component "[pdf_templates]" as PDFTemplatesTbl
  }
  
  package "🔎 Scraper Domain" as ScraperTables {
    component "[scrape_jobs]" as ScraperJobsTbl
    component "[scrape_history]" as ScraperHistoryTbl
  }
  
  package "⏰ Cron & Notifications" as CronTables {
    component "[cron_jobs]" as CronJobsTbl
    component "[cron_history]" as CronHistoryTbl
    component "[notifications]" as NotificationsTbl
  }
  
  package "🔐 Security" as SecurityTables {
    component "[auth.users]\n(Supabase Auth)" as AuthUsersTbl
  }
}





@startuml Office-AI-Agent-Class-Diagram
title The Office AI Agent - Class Diagram
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam BackgroundColor #FFFFFF
skinparam shadowing false
skinparam classBorderColor #333333
skinparam classBackgroundColor #FAFAFA
skinparam packageBorderColor #888888
skinparam packageBackgroundColor #F5F5F5
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #FBC02D

' Kolory dla różnych sekcji
skinparam package<<Frame>>BackgroundColor #E3F2FD
skinparam package<<Database>>BackgroundColor #E8F5E9
skinparam package<<Folder>>BackgroundColor #F3E5F5
skinparam package<<Cloud>>BackgroundColor #FFF3E0
skinparam class<<Service>>BackgroundColor #FFFDE7
skinparam class<<Type>>BackgroundColor #E3F2FD
skinparam class<<Utility>>BackgroundColor #F3E5F5
skinparam class<<Database>>BackgroundColor #E8F5E9
skinparam class<<Cloud>>BackgroundColor #FFF3E0

' Kolory strzałek dla różnych typów relacji
skinparam classAssociationArrowColor #1976D2
skinparam classAssociationArrowThickness 2
skinparam classAggregationArrowColor #388E3C
skinparam classAggregationArrowThickness 2
skinparam classCompositionArrowColor #FBC02D
skinparam classCompositionArrowThickness 2
skinparam classDependencyArrowColor #8E24AA
skinparam classDependencyArrowThickness 2
skinparam classGeneralizationArrowColor #616161
skinparam classGeneralizationArrowThickness 2

' ============ TYPE DEFINITIONS ============

package "Type Definitions" <<Frame>> #E3F2FD {
    enum TaskType <<Type>> #BBDEFB {
        EMAIL
        PDF_GENERATION
        WEB_SCRAPING
        SCHEDULED
        AI_REQUEST
    }
    
    enum TaskStatus <<Type>> #BBDEFB {
        PENDING
        IN_PROGRESS
        COMPLETED
        FAILED
        CANCELLED
    }
    
    enum Priority <<Type>> #BBDEFB {
        LOW
        MEDIUM
        HIGH
        URGENT
    }
    
    class AgentTask <<Type>> #E3F2FD {
        +id: string
        +type: TaskType
        +description: string
        +status: TaskStatus
        +priority: Priority
        +createdAt: Date
        +updatedAt: Date
        +completedAt?: Date
        +result?: any
        +error?: string
    }
    
    class EmailConfig <<Type>> #E3F2FD {
        +to: string | string[]
        +subject: string
        +text?: string
        +html?: string
        +attachments?: EmailAttachment[]
    }
    
    class EmailAttachment <<Type>> #E3F2FD {
        +filename: string
        +content?: Buffer
        +path?: string
    }
    
    class PDFGenerationOptions <<Type>> #E3F2FD {
        +title?: string
        +author?: string
        +subject?: string
        +outputPath?: string
    }
    
    class ScrapingConfig <<Type>> #E3F2FD {
        +url: string
        +selectors?: Map<string, string>
        +waitFor?: number
    }
    
    class AIRequest <<Type>> #E3F2FD {
        +prompt: string
        +context?: any
        +model?: string
        +temperature?: number
        +maxTokens?: number
    }
    
    class AIResponse <<Type>> #E3F2FD {
        +content: string
        +model: string
        +tokensUsed?: number
    }
    
    class CronJobConfig <<Type>> #E3F2FD {
        +name: string
        +schedule: string
        +task: () => Promise<void>
        +enabled: boolean
    }
}

' ============ SERVICE CLASSES ============

package "Services Layer" <<Database>> #E8F5E9 {
    
    class AIService <<Service>> #FFFDE7 {
        -apiKey: string
        -apiUrl: string
        -model: string
        
        +sendRequest(request: AIRequest): Promise<AIResponse>
        +processTask(taskDescription: string, context?: any): Promise<string>
        +analyzeText(text: string, analysisType: string): Promise<any>
        +chat(currentMessage: string, conversationHistory?: Array): Promise<string>
        +getUserContext(userId: string): Promise<string>
        +generateEmailTemplate(category: string, additionalContext?: string, userId?: string): Promise<{subject: string, body: string}>
        +generatePDFContent(category: string, additionalContext?: string, userId?: string): Promise<string>
    }
    
    class AgentOrchestrator <<Service>> #FFFDE7 {
        -tools: Tool[]
        
        -getSystemPrompt(): string
        +analyzeIntent(message: string, userId?: string): Promise<AgentAction>
        +executeAction(action: AgentAction, userId?: string): Promise<string>
        -executeSendEmail(params: any, userId?: string): Promise<string>
        -executeGeneratePDF(params: any, userId?: string): Promise<string>
        -executeScrapeWebsite(params: any, userId?: string): Promise<string>
        -executeCreateCronJob(params: any, userId?: string): Promise<string>
        -executeConversation(params: any, userId?: string): Promise<string>
        +processMessage(message: string, userId?: string, conversationHistory?: any[]): Promise<string>
    }
    
    class Tool <<Type>> #E3F2FD {
        +name: string
        +description: string
        +parameters: any
    }
    
    class AgentAction <<Type>> #E3F2FD {
        +tool: string
        +reasoning: string
        +parameters: any
    }
    
    class EmailService <<Service>> #FFFDE7 {
        -transporter: Transporter
        
        +sendEmail(config: EmailConfig): Promise<void>
        +sendBulkEmails(configs: EmailConfig[]): Promise<void>
        +verifyConnection(): Promise<boolean>
    }
    
    class EmailInboxService <<Service>> #FFFDE7 {
        +scanInbox(userId: string): Promise<{success: boolean, emailsFound: number}>
        -fetchUnreadEmails(config: ImapConfig, password: string): Promise<ParsedEmail[]>
        -processEmail(userId: string, email: ParsedEmail): Promise<void>
        -analyzeEmailWithAI(email: ParsedEmail): Promise<EmailAnalysis>
        -generateAIDraft(userId: string, inboxEmailId: string, email: ParsedEmail): Promise<void>
        +generateDraftForEmail(userId: string, email: any): Promise<any>
        +sendApprovedDraft(draftId: string, userId: string): Promise<boolean>
    }
    
    class ImapConfig <<Type>> #E3F2FD {
        +id: string
        +user_id: string
        +imap_host: string
        +imap_port: number
        +imap_user: string
        +imap_password: string
        +use_ssl: boolean
    }
    
    class ParsedEmail <<Type>> #E3F2FD {
        +messageId: string
        +from: {address: string, name?: string}
        +to: string
        +subject: string
        +text: string
        +html: string
        +date: Date
        +hasAttachments: boolean
        +attachmentsCount: number
    }
    
    class EmailAnalysis <<Type>> #E3F2FD {
        +priority: string
        +category: string
        +sentiment: string
        +summary: string
        +suggestedAction: string
    }
    
    class PDFService <<Service>> #FFFDE7 {
        +generatePDF(content: string, outputPath: string, options?: PDFGenerationOptions): Promise<string>
        +generateStructuredPDF(data: any, outputPath: string, template?: string): Promise<string>
    }
    
    class ScraperService <<Service>> #FFFDE7 {
        -aiService: AIService
        
        +scrapeWebPage(config: ScrapingConfig): Promise<any>
        +scrapeWithAI(config: {url: string, prompt: string, selectors?: any}): Promise<any>
        +analyzePageStructure(url: string): Promise<any>
        +scrapeMultiplePages(configs: ScrapingConfig[]): Promise<any[]>
        +extractData(html: string, selector: string): string[]
    }
    
    class CronService <<Service>> #FFFDE7 {
        -jobs: Map<string, ScheduledTask>
        
        +scheduleJob(config: CronJobConfig): void
        +stopJob(name: string): void
        +startJob(name: string): void
        +stopAllJobs(): void
        +getActiveJobs(): string[]
    }
}

' ============ UTILITY CLASSES ============

package "Utilities" <<Folder>> #F3E5F5 {
    class EncryptionUtils <<Utility>> #F3E5F5 {
        +encrypt(text: string): string
        +decrypt(encryptedText: string): string
    }
    
    class InitDirectories <<Utility>> #F3E5F5 {
        +initUploadsDirs(): void
    }
    
    class ValidateEnv <<Utility>> #F3E5F5 {
        +validateRequiredEnvVars(): void
    }
}

' ============ DATABASE CLIENT ============

package "Database Configuration" <<Cloud>> #FFF3E0 {
    class SupabaseClient <<Cloud>> #FFE0B2 {
        +from(table: string): QueryBuilder
        +auth: AuthClient
        +storage: StorageClient
    }
    
    class SupabaseAdminClient <<Cloud>> #FFE0B2 {
        +from(table: string): QueryBuilder
        <<bypasses RLS>>
    }
}

' ============ RELATIONSHIPS ============


' Type Dependencies
AgentTask *-- TaskType : <color:#FBC02D>
AgentTask *-- TaskStatus : <color:#FBC02D>
AgentTask *-- Priority : <color:#FBC02D>
EmailConfig o-- EmailAttachment : <color:#388E3C>

' Agent Orchestrator Dependencies
AgentOrchestrator --> AgentAction : creates <color:#8E24AA>
AgentOrchestrator --> Tool : uses <color:#8E24AA>
AgentOrchestrator --> AIService : uses <color:#8E24AA>
AgentOrchestrator --> EmailService : uses <color:#8E24AA>
AgentOrchestrator --> PDFService : uses <color:#8E24AA>
AgentOrchestrator --> ScraperService : uses <color:#8E24AA>
AgentOrchestrator --> CronService : uses <color:#8E24AA>

' Service Dependencies
AIService --> AIRequest : uses <color:#1976D2>
AIService --> AIResponse : returns <color:#1976D2>
EmailService --> EmailConfig : uses <color:#1976D2>
EmailInboxService --> ImapConfig : uses <color:#1976D2>
EmailInboxService --> ParsedEmail : processes <color:#1976D2>
EmailInboxService --> EmailAnalysis : creates <color:#1976D2>
EmailInboxService --> AIService : uses <color:#1976D2>
PDFService --> PDFGenerationOptions : uses <color:#1976D2>
ScraperService --> ScrapingConfig : uses <color:#1976D2>
ScraperService --> AIService : uses <color:#1976D2>
CronService --> CronJobConfig : uses <color:#1976D2>

' Database Dependencies
AgentOrchestrator --> SupabaseAdminClient : queries <color:#0288D1>
AIService --> SupabaseAdminClient : queries <color:#0288D1>
EmailService --> SupabaseAdminClient : queries <color:#0288D1>
EmailInboxService --> SupabaseAdminClient : queries <color:#0288D1>
PDFService --> SupabaseAdminClient : queries <color:#0288D1>
ScraperService --> SupabaseAdminClient : queries <color:#0288D1>
CronService --> SupabaseAdminClient : queries <color:#0288D1>

' Utility Dependencies
EmailService --> EncryptionUtils : uses <color:#CE93D8>
EmailInboxService --> EncryptionUtils : uses <color:#CE93D8>

note top of AgentOrchestrator
  Central orchestration service that:
  • Interprets user natural language
  • Determines appropriate tool/action
  • Executes actions via specialized services
  • Provides unified interface for AI agent
end note

note top of AIService
  AI Integration service:
  • Gemini AI API communication
  • User context management
  • Template generation
  • Multi-turn conversation
end note

note top of EmailInboxService
  Advanced email management:
  • IMAP inbox scanning
  • AI-powered email analysis
  • Automatic draft generation
  • Smart categorization
end note

note top of ScraperService
  Intelligent web scraping:
  • Manual CSS selector scraping
  • AI-powered data extraction
  • Page structure analysis
  • Multi-page scraping
end note

legend right
    |= Symbol / Kolor |= Znaczenie |
    | <back:#FFFDE7>Service</back> | Warstwa logiki biznesowej (serwisy: AIService, EmailService, itd.) |
    | <back:#E3F2FD>Type</back> | Definicje typów i struktur danych (np. AgentTask, EmailConfig) |
    | <back:#F3E5F5>Utility</back> | Klasy pomocnicze/narzędziowe (np. EncryptionUtils) |
    | <back:#E8F5E9>Database</back> | Warstwa dostępu do bazy danych |
    | <back:#FFF3E0>Cloud</back> | Klasy do obsługi chmury/Supabase |
    | <b>Gruba linia</b> | Główna zależność lub użycie |
    | *-- | Kompozycja (zawiera) |
    | o-- | Agregacja (ma, ale nie zarządza cyklem życia) |
    | --> | Użycie lub zależność |
    | <<Frame>> | Pakiet typów (Type Definitions) |
    | <<Database>> | Pakiet serwisów biznesowych |
    | <<Folder>> | Pakiet utili |
    | <<Cloud>> | Pakiet konfiguracji bazy/chmury |
  
    **Wzorzec architektury:**
    • Service – logika biznesowa
    • Type – bezpieczeństwo typów i model danych
    • Utility – funkcje wspólne dla wielu serwisów
    • Wszystkie serwisy korzystają z Supabase do zapisu/odczytu
endlegend

@enduml

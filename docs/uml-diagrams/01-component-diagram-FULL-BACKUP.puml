@startuml Office-AI-Agent-Clean
title The Office AI Agent - Production Architecture (Senior Level)

!define LIGHTBLUE #E3F2FD
!define LIGHTGREEN #E8F5E9
!define LIGHTPURPLE #F3E5F5
!define LIGHTYELLOW #FFFDE7
!define LIGHTORANGE #FFF3E0

skinparam componentStyle rectangle
skinparam BackgroundColor #FAFAFA
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowThickness 2
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 35

top to bottom direction

' ============================================
' EXTERNAL APIS
' ============================================
package "☁️ EXTERNAL APIs" as External LIGHTORANGE {
  [🤖 Gemini AI] as Gemini
  [📧 Gmail API] as Gmail
  [🌐 Web Scraping] as Web
}

' ============================================
' FRONTEND LAYER
' ============================================
package "🎨 FRONTEND (Next.js 16)" as Frontend LIGHTBLUE {
  
  package "📱 Pages" {
    [Dashboard] as PageDash
    [Agent] as PageAgent
    [Email] as PageEmail
    [Inbox] as PageInbox
    [PDF] as PagePDF
    [Scraper] as PageScraper
    [Tasks] as PageTasks
    [Notifications] as PageNotif
    [Settings] as PageSettings
    [Auth] as PageAuth
  }
  
  package "🪝 Custom Hooks" {
    [useAgent] as HookAgent
    [useEmail] as HookEmail
    [usePDF] as HookPDF
    [useScraper] as HookScraper
    [useTasks] as HookTasks
    [useNotifications] as HookNotif
  }
  
  package "🔧 Core Services" {
    [lib/auth.ts\n11 functions] as AuthLib
    [lib/api.ts\nAxios + Interceptors] as APIClient
    [lib/supabase.ts\nDB Client] as SupabaseFrontend
  }
}

' ============================================
' BACKEND LAYER
' ============================================
package "🎯 BACKEND (Express 5)" as Backend LIGHTPURPLE {
  
  package "🛡️ Middleware Pipeline" {
    [Helmet + CORS] as Security
    [Request Logger] as ReqLogger
    [Rate Limiter] as RateLimit
    [Auth (optional/required)] as AuthMW
    [Error Handler] as ErrorHandler
  }
  
  package "📍 Routes (13 endpoints)" {
    [/agent] as RouteAgent
    [/ai] as RouteAI
    [/email] as RouteEmail
    [/email-inbox] as RouteInbox
    [/email-config] as RouteEmailConfig
    [/email-templates] as RouteEmailTpl
    [/pdf] as RoutePDF
    [/scraper] as RouteScraper
    [/cron] as RouteCron
    [/dashboard] as RouteDash
    [/notifications] as RouteNotif
    [/user/context] as RouteUserCtx
    [/search] as RouteSearch
  }
  
  package "🎯 Controllers (3 total)" {
    [BaseController\nAbstract Base] as BaseCtrl
    [AgentController\nextends Base] as AgentCtrl
    [DashboardController\nextends Base] as DashCtrl
  }
}

' ============================================
' DOMAIN LAYER
' ============================================
package "💎 DOMAIN LOGIC" as Domain LIGHTGREEN {
  
  [AgentOrchestrator\nMediator Pattern] as Orchestrator
  
  package "⚡ Services (7 active)" {
    [AIService\nGemini 2.0] as AIService
    [EmailInboxService\nIMAP + AI] as InboxService
    [EmailService\nnodemailer] as EmailService
    [PDFService\nPuppeteer] as PDFService
    [ScraperService\nCheerio] as ScraperService
    [CronService\nnode-cron] as CronService
    [UserContextService\nBaseService<T>] as UserContextService
  }
  
  [BaseService<T>\nGeneric Repository] as BaseService
}

' ============================================
' INFRASTRUCTURE
' ============================================
package "🏗️ INFRASTRUCTURE" as Infra LIGHTYELLOW {
  [Supabase Admin\nService Role] as SupabaseBackend
  [Logger] as Logger
  [Cache] as Cache
  [Config] as Config
  [Encryption] as Encryption
}

' ============================================
' DATABASE
' ============================================
database "🗄️ DATABASE (PostgreSQL + RLS)" as DB {
  [user_profiles] as ProfilesTbl
  [user_email_configs] as EmailConfigsTbl
  [user_imap_configs] as IMAPConfigsTbl
  [emails_inbox] as InboxTbl
  [emails_sent] as EmailsSentTbl
  [email_templates] as EmailTemplatesTbl
  [email_attachments] as AttachmentsTbl
  [ai_email_drafts] as DraftsTbl
  [email_scan_logs] as ScanLogsTbl
  [scheduled_emails] as ScheduledEmailsTbl
  [pdf_files] as PDFTbl
  [pdf_templates] as PDFTemplatesTbl
  [scrape_jobs] as ScraperJobsTbl
  [scrape_history] as ScraperHistoryTbl
  [cron_jobs] as CronJobsTbl
  [notifications] as NotificationsTbl
  [chat_messages] as ChatMessagesTbl
}


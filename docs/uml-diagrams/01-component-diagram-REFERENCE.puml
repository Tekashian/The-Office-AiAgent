        component "🔎 ScraperService\n(Standalone)" as ScraperService #A5D6A7
        component "⏰ CronService\n(Standalone)" as CronService #A5D6A7
        component "👤 UserContextService\nextends BaseService" as UserContextService #A5D6A7
        

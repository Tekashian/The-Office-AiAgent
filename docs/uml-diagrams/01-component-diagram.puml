@startuml Office-AI-Agent-Simple
title The Office AI Agent - Simplified Architecture

!define LIGHTBLUE #E3F2FD
!define LIGHTGREEN #E8F5E9
!define LIGHTPURPLE #F3E5F5

skinparam componentStyle rectangle
skinparam BackgroundColor #FAFAFA

' ============================================
' SIMPLIFIED 3-TIER
' ============================================

package "🎨 FRONTEND" as Frontend LIGHTBLUE {
  component "Pages (12)" as Pages
  component "Hooks (6)" as Hooks
  component "lib/auth.ts" as Auth
  component "lib/api.ts" as API
  component "lib/supabase.ts" as Supabase
  
  Pages -down-> Hooks : "useState"
  Hooks -down-> API : "HTTP"
  API -down-> Auth : "getAccessToken()"
  Auth -down-> Supabase : "supabase.auth.*"
  
  note right of Auth
    **Authentication Service**
    • signUp/signIn/signOut
    • getAccessToken()
    • getCurrentUser()
    
    Used by: 28+ locations
  end note
  
  note right of API
    **HTTP Client + Interceptors**
    
    REQUEST Interceptor:
    • await getAccessToken()
    • Inject: Bearer token
    
    RESPONSE Interceptor:
    • 401 → redirect /auth
  end note
}

package "🎯 BACKEND" as Backend LIGHTPURPLE {
  component "Middleware\nPipeline" as Middleware
  component "Routes (13)" as Routes
  component "Controllers" as Controllers
  component "Services (7)" as Services
  
  Middleware -down-> Routes : "JWT validation"
  Routes -down-> Controllers : "HTTP handlers"
  Controllers -down-> Services : "Business logic"
  
  note right of Middleware
    **Auth Middleware**
    • Extract token
    • Validate with Supabase
    • Attach req.userId
  end note
}

package "💎 DOMAIN" as Domain LIGHTGREEN {
  component "Agent\nOrchestrator" as Orchestrator
  component "AI Service\n(Gemini)" as AIService
  component "PDF Service" as PDFService
  component "Email Service" as EmailService
  
  Orchestrator -down-> AIService : "analyzeIntent()"
  Orchestrator -down-> PDFService : "generate()"
  Orchestrator -down-> EmailService : "send()"
}

database "🗄️ DATABASE" as DB {
  component "[user_profiles]" as Users
  component "[emails_sent]" as Emails
  component "[pdf_files]" as PDFs
  component "[cron_jobs]" as Crons
}

' ============================================
' CONNECTIONS
' ============================================

API --> Middleware : "POST /api/*\nAuthorization: Bearer <token>"
Services --> DB : "SQL queries\nWHERE user_id = ?"
Controllers --> Orchestrator : "processMessage()"

' ============================================
' AUTH FLOW (CRITICAL)
' ============================================

note bottom
  **🔐 TOKEN INJECTION FLOW:**
  
  1. User login → JWT saved to localStorage
  2. Hook calls API → REQUEST interceptor
  3. getAccessToken() → extract token
  4. Inject: Authorization: Bearer <token>
  5. Backend validates → req.userId attached
  
  **Pattern:** Service Facade + Interceptor
  **Security:** JWT + RLS + AES-256
end note

@enduml

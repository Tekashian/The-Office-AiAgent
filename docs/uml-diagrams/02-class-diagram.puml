        +path?: string
    }
    
    class PDFGenerationOptions <<Type>> #E3F2FD {
        +title?: string
        +author?: string
        +subject?: string
        +outputPath?: string
    }
    
    class ScrapingConfig <<Type>> #E3F2FD {
        +url: string
        +selectors?: Map<string, string>
        +waitFor?: number
    }
    
    class AIRequest <<Type>> #E3F2FD {
        +prompt: string
        +context?: any
        +model?: string
        +temperature?: number
        +maxTokens?: number
